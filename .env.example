# токен бота от @BotFather
BOT_TOKEN=
# https://my.telegram.org -> API development tools
API_ID=
API_HASH=
# ключ шифрования сессий:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_KEY=
# Telegram ID тех, кому можно подключаться (через запятую). Свой ID бот покажет при /start
ALLOWED_IDS=
# необязательно
WARN_AT=0.5
BLOCK_AT=0.85
MAX_BLOCKS_PER_HOUR=5
# группы и каналы (необязательно)
GROUP_CHECK=1
GROUP_WARN_AT=0.5
GROUP_LEAVE_AT=0.85
GROUP_LEAVE_LABELS=gambling
MAX_LEAVES_PER_HOUR=10
GROUP_RECHECK_DAYS=7

# Администраторы: получают заявки на доступ (кнопки Одобрить/Отклонить), через запятую
ADMIN_IDS=
MAX_ACCESS_REQUESTS_PER_HOUR=5

# WhatsApp через Evolution API (см. docker-compose.yml и evolution.env.example)
EVOLUTION_URL=http://evolution:8080
EVOLUTION_API_KEY=            # тот же, что AUTHENTICATION_API_KEY в evolution.env
WA_WEBHOOK_SECRET=            # случайная строка: openssl rand -hex 16
WA_PAIR_TTL_SEC=300           # сколько ждём сканирования QR; потом экземпляр удаляется
WA_CLOSED_TTL_SEC=3600        # сколько терпим подключённый экземпляр без связи
MAX_WA_INSTANCES=10

# Проверка ссылок (списки казино/фишинга скачиваются сами и обновляются раз в сутки)
LINKS_ENABLED=1
LINKS_RDAP=1                  # возраст домена через RDAP (rdap.org): отправляется только имя домена; 0 = выключить
LINK_WARN_KNOWN=0.8           # порог предупреждения о ссылке от ЗНАКОМОГО (вдруг взломали)
LINKS_DIR=lists

# Аналитика (сайт на Vercel / Mini App): см. web/README.md. Пока SITE_URL пуст, отправка выключена
SITE_URL=
INGEST_SECRET=
SITE_SECRET=
ANALYTICS_PSEUDO_KEY=         # тот же, что PSEUDO_KEY на Vercel (если пусто, берётся производный от SESSION_KEY)
ANALYTICS_PUSH_MIN=30
RETENTION_DAYS=180            # срок хранения сырых событий (метаданные, без текстов)
ANALYTICS_TZ_HOURS=5          # часовой пояс для дней в отчёте (Казахстан = 5)
REPORT_AS_WEBAPP=0            # 1 = открывать отчёт как Telegram Mini App
